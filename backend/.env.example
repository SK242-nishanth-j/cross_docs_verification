# Placeholders only. Copy to .env (and optionally .env.dev / .env.staging / .env.prod).
# .env is loaded first, then .env.<ENVIRONMENT> (which wins). Never commit real
# values. List values are JSON.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- AWS Bedrock ------------------------------------------------------------
# Put real keys only in your git-ignored .env (never in this file).
# AWS_SESSION_TOKEN is required for temporary (STS/SSO) credentials.
# Qwen3 32B and Qwen3 VL 235B are available in-region in ap-south-1.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional: overrides the model of EVERY prompt in src/ai/prompts/configs/*.yaml.
# Leave empty in vision_llm mode (the vision prompts need a vision model).
BEDROCK_MODEL_ID=

# ---- Anomaly Detection mode -------------------------------------------------
# vision_llm | structured | ocr_llm | ocr_hybrid. Empty uses "mode" in
# src/config/anomaly_config.yaml. The UI follows the mode the backend reports.
ANOMALY_MODE=
BEDROCK_CONNECT_TIMEOUT_S=10
BEDROCK_READ_TIMEOUT_S=180
BEDROCK_MAX_ATTEMPTS=3

# ---- Processing -------------------------------------------------------------
EXTRACTION_WORKERS=4
DOCUMENT_MAX_OCR_CHARS=40000
AUTOFILL_MAX_OCR_CHARS=60000

# ---- Storage ----------------------------------------------------------------
# Layout: <DATA_DIR>/<case_id>/{lead.json, result.json, runs/<run_id>.json}
DATA_DIR=storage

# ---- HTTP -------------------------------------------------------------------
# Browser origins allowed to call this API. Not needed when the frontend reaches
# the API through the Vite dev proxy or a same-origin reverse proxy.
CORS_ALLOWED_ORIGINS=["https://<frontend-host>"]
# Per-client limit applied to every endpoint: <count>/<second|minute|hour|day>
RATE_LIMIT=60/minute
# Largest request body (all documents' OCR JSON in one trigger)
MAX_REQUEST_MB=50
