  "info": {
    "description": "Application-form auto-fill, lead creation (base truth) and the trigger that runs the Orchestrator Agent and the Anomaly Detection Agent. Rate limit: 60/minute per client (the health probe is exempt).",
    "title": "Underwriting Copilot: Orchestrator + Anomaly Detection",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the service is running.\n\nReturns:\n    ``{\"status\": \"ok\"}``.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/cases/{case_id}/lead": {
      "get": {
        "description": "Return the saved lead of a case.\n\nArgs:\n    case_id: The case.\n    service: The case service.\n\nReturns:\n    The lead record.",
        "operationId": "get_lead_v1_cases__case_id__lead_get",
        "parameters": [
          {
            "description": "Case / application number",
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "description": "Case / application number",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read the saved lead",
        "tags": [
          "leads"
        ]
      },
      "post": {
        "description": "Save the lead of a case.\n\nArgs:\n    case_id: The case.\n    body: The reviewed lead.\n    service: The case service.\n\nReturns:\n    The stored lead record.",
        "operationId": "create_lead_v1_cases__case_id__lead_post",
        "parameters": [
          {
            "description": "Case / application number",
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "description": "Case / application number",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save the reviewed lead (base truth)",
        "tags": [
          "leads"
        ]
      }
    },
    "/v1/cases/{case_id}/result": {
      "get": {
        "description": "Return the latest result of a case.\n\nArgs:\n    case_id: The case.\n    service: The case service.\n\nReturns:\n    The run result.",
        "operationId": "get_result_v1_cases__case_id__result_get",
        "parameters": [
          {
            "description": "Case / application number",
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "description": "Case / application number",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read the latest result",
        "tags": [
          "cases"
        ]
      }
    },
    "/v1/cases/{case_id}/trigger": {
      "post": {
        "description": "Run the Orchestrator Agent (and through it the Anomaly Detection Agent).\n\nArgs:\n    case_id: The case; its lead must exist.\n    files: Every document (format depends on the mode).\n    documents: Who each file belongs to and its type, by file name.\n    service: The case service.\n    settings: Application settings (limits).\n    mock_overrides: Forced mock third-party answers per person.\n\nReturns:\n    The run result with the orchestrator summary and the full report.\n\nRaises:\n    InvalidInputError: If a file or the metadata is not accepted.",
        "operationId": "trigger_v1_cases__case_id__trigger_post",
        "parameters": [
          {
            "description": "Case / application number",
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "description": "Case / application number",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_trigger_v1_cases__case_id__trigger_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run the agents on a case",
        "tags": [
          "cases"
        ]
      }
    },
    "/v1/info": {
      "get": {
        "description": "Return what the UI needs: the mode, the accepted files and the models.\n\nArgs:\n    settings: Application settings.\n\nReturns:\n    Environment, region, mode, accepted file types, models and the provider.",
        "operationId": "info_v1_info_get",
        "responses": {
