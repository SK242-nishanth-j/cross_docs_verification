  "info": {
    "description": "Application-form auto-fill, lead creation (base truth) and the trigger that runs the Orchestrator Agent and the Anomaly Detection Agent. Rate limit: 60/minute per client (the health probe is exempt).",
    "title": "Underwriting Copilot: Orchestrator + Anomaly Detection",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the service is running.\n\nReturns:\n    ``{\"status\": \"ok\"}``.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/cases/{case_id}/lead": {
      "get": {
        "description": "Return the saved lead of a case.\n\nArgs:\n    case_id: The case.\n    service: The case service.\n\nReturns:\n    The lead record.",
        "operationId": "get_lead_v1_cases__case_id__lead_get",
        "parameters": [
          {
            "description": "Case / application number",
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "description": "Case / application number",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Case Id",
              "type": "string"
            }
