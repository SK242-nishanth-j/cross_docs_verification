{
  "config_label": "2026-11-24.2",
  "id_patterns": {
    "passport": "[A-Z][0-9]{7}",
    "driving_licence": "[A-Z]{2}[0-9]{11,13}"
  },
  "extraction": {
    "max_ocr_chars": 40000,
    "fields_by_doc_type": {
      "PAN":                ["name", "father_name", "dob", "id_number"],
      "AADHAAR":            ["name", "dob", "gender", "father_name", "spouse_name", "address", "id_number"],
      "PASSPORT":           ["name", "dob", "gender", "id_number", "father_name", "mother_name", "spouse_name", "address"],
      "VOTER_ID":           ["name", "father_name", "spouse_name", "gender", "dob", "address", "id_number"],
      "DRIVING_LICENCE":    ["name", "father_name", "spouse_name", "dob", "address", "id_number"],
      "MARKSHEET":          ["name", "father_name", "mother_name", "dob"],
      "DEGREE_CERTIFICATE": ["name", "father_name", "mother_name", "dob"],
      "ADMIT_LETTER":       ["name", "dob"],
      "OTHER":              ["name", "father_name", "mother_name", "dob", "address", "id_number"]
    }
  },
  "kyc_rules": {
    "face_match_min_pct": 75,
    "bureau_address_window_months": 12,
    "voter_dl_verification_window_days": null
  },
  "mock_defaults": {
    "face_match_pct": 92.0,
    "face_match_status": "SUCCESS",
    "bureau_address_age_days": 60
  },
  "rules": {
    "KY-01": {"title": "Name / DOB mismatch", "severity": "High",
              "mitigant": "Obtain affidavit / one-and-same-person declaration; correct manual bureau record; recommend basis justification."},
    "KY-02": {"title": "Address mismatch with bureau (last 1 year)", "severity": "Medium",
              "mitigant": "Obtain address proof / residence verification."},
    "KY-03": {"title": "PAN-Aadhaar linkage (Karza)", "severity": "Medium",
              "mitigant": "Linkage before disbursement."},
    "KY-04": {"title": "Voter ID / Driving Licence verification (Karza)", "severity": "Low",
              "mitigant": "Provide justification by CM."},
    "KY-05": {"title": "Email ID validation", "severity": "Low",
              "mitigant": "Correct before sanction."},
    "KY-06": {"title": "Face match completion (>= 75%)", "severity": "High",
              "mitigant": "Critical: if face match is below 75%, the credit manager must justify it in OTHER REMARKS in the CAM."}
  },
  "checks": {
    "NAME":              {"rule_id": "KY-01", "severity": "High"},
    "PARENT_NAME":       {"rule_id": "KY-01", "severity": "High",
                          "mitigant": "Confirm the co-applicant is the applicant's parent; obtain relationship proof / one-and-same-person declaration."},
    "DOB":               {"rule_id": "KY-01", "severity": "High"},
    "FATHER_NAME":       {"rule_id": null, "severity": "Medium",
                          "mitigant": "Clarify the father's name; obtain one-and-same-person declaration if needed."},
    "MOTHER_NAME":       {"rule_id": null, "severity": "Medium",
                          "mitigant": "Clarify the mother's name; obtain one-and-same-person declaration if needed."},
    "ADDRESS":           {"rule_id": null, "severity": "Medium",
                          "mitigant": "Obtain address proof / residence verification."},
    "HOUSEHOLD_ADDRESS": {"rule_id": null, "severity": "Medium",
                          "mitigant": "Confirm where the parent co-applicant lives; obtain address proof."},
    "PAN":               {"rule_id": null, "severity": "High",
                          "mitigant": "Correct the PAN in the lead or obtain the correct PAN card."},
    "AADHAAR":           {"rule_id": null, "severity": "High",
                          "mitigant": "Correct the Aadhaar number in the lead or obtain the correct Aadhaar."},
    "PASSPORT_NO":       {"rule_id": null, "severity": "Medium",
                          "mitigant": "Correct the passport number in the lead or obtain the correct passport copy."},
    "DL_NO":             {"rule_id": null, "severity": "Medium",
                          "mitigant": "Correct the licence number in the lead or obtain the correct licence copy."},
    "VOTER_ID":          {"rule_id": null, "severity": "Medium",
                          "mitigant": "Correct the voter ID in the lead or obtain the correct voter ID copy."}
  }
}
