# Placeholders only. Copy to .env.local (ignored by git) and edit.
# Backend base URL used by the browser. Leave empty to call the same origin
# (works with the Vite dev proxy or a reverse proxy in front of both apps).
# When set, the backend must list this app's origin in CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
# Dev server only: backend origin that Vite forwards /v1 and /health to.
VITE_DEV_PROXY_TARGET=https://<backend-host>
# Browser-side timeouts in milliseconds. Auto-fill and the trigger include LLM
# calls, so they need minutes, not seconds.
VITE_AUTOFILL_TIMEOUT_MS=300000
VITE_TRIGGER_TIMEOUT_MS=600000
VITE_DEFAULT_TIMEOUT_MS=30000
